# Local server
PORT=47231

# Demo mode is the default. Set to false to scan Gmail when it is connected.
# Explicit tool argument source=demo still uses example emails.
DEMO_MODE=true

# Gmail read-only OAuth. Leave blank to stay in demo mode.
# Scope used by the server: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:47231/auth/google/callback

# Optional. If you already have a refresh token, the server can refresh access
# without the browser flow. Never commit a real token.
GMAIL_REFRESH_TOKEN=

# Optional. Used only when the heuristic parser finds a trial but is missing
# a price or an end date. Leave blank to skip the model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
